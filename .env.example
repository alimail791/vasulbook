# ---- Required ----
# PostgreSQL connection string. On Railway use: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://user:password@localhost:5432/vasulbook
# Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
NODE_ENV=production
# Public address of the app (used in email links), e.g. https://vasulbook.up.railway.app
APP_URL=

# ---- Email (Resend) ----
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Sender. Must be on a domain you verified in Resend, e.g. "VasulBook <hello@vasulbook.in>"
EMAIL_FROM=
# Who gets the "new registration" alert. Several addresses: separate with commas.
ADMIN_EMAIL=

# ---- Optional: automatic WhatsApp reminders (Meta WhatsApp Cloud API) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Name of an approved template with 4 body variables: {{1}} name, {{2}} amount, {{3}} shop, {{4}} how to pay
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
